# Network Security Graph RAG - backend environment variables
# Copy this file to .env (in this backend/ directory) and fill in your values:
#   cp .env.example .env
#
# .env is gitignored; never commit real credentials.

# ===========================================
# REQUIRED: LLM API Key
# ===========================================
# Get a free API key from https://console.groq.com
# Only required when LLM_PROVIDER=groq (the default).
GROQ_API_KEY=your_groq_api_key_here

# ===========================================
# LLM Configuration
# ===========================================
# Provider: "groq" (default, online) or "ollama" (local, needs Ollama running)
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ===========================================
# Neo4j Configuration
# ===========================================
# NEO4J_URI defaults to the compose service name; use bolt://localhost:7687
# when running the API outside Docker against a local Neo4j.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# For docker-compose: must equal NEO4J_USER/NEO4J_PASSWORD above.
NEO4J_AUTH=neo4j/password

# ===========================================
# Auto-Processing
# ===========================================
# Ingest any CSVs in backend/sample_data/ on startup.
ENABLE_AUTO_PROCESS=true

# ===========================================
# API Settings
# ===========================================
# CORS origins: comma-separated, or a JSON array. Use * to allow any origin
# (credentials are automatically disabled when * is present).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
API_PREFIX=/api

# ===========================================
# Debug Settings (set DEBUG=false in production)
# ===========================================
DEBUG=false
LOG_LEVEL=INFO
